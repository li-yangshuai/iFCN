{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifcn.example/schema/sequential-paper-benchmark-v1.json",
  "title": "iFCN sequential paper benchmark provenance",
  "description": "Source provenance, reconstruction scope, sequential semantics, and expected iFCN pipeline support for one paper-derived benchmark. Generated run metadata belongs in a separate run manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "benchmark_id",
    "module",
    "classification",
    "source",
    "reconstruction",
    "semantics",
    "files",
    "reported_metrics",
    "expected_pipeline",
    "validation"
  ],
  "properties": {
    "schema": {
      "const": "ifcn.sequential.paper_benchmark.v1"
    },
    "benchmark_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*\\/[a-z][a-z0-9_]*$"
    },
    "module": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"
    },
    "classification": {
      "$ref": "#/$defs/classification"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "reconstruction": {
      "$ref": "#/$defs/reconstruction"
    },
    "semantics": {
      "$ref": "#/$defs/semantics"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "reported_metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reportedMetric"
      }
    },
    "expected_pipeline": {
      "$ref": "#/$defs/expectedPipeline"
    },
    "validation": {
      "$ref": "#/$defs/validation"
    }
  },
  "$defs": {
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "state_element", "trigger_model", "bit_width"],
      "properties": {
        "domain": {
          "const": "sequential"
        },
        "state_element": {
          "enum": ["dff", "d_latch", "sr_flip_flop", "sr_latch"]
        },
        "trigger_model": {
          "enum": ["edge", "level"]
        },
        "bit_width": {
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state_element": {"enum": ["d_latch", "sr_latch"]}
            },
            "required": ["state_element"]
          },
          "then": {
            "properties": {
              "trigger_model": {"const": "level"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "state_element": {"enum": ["dff", "sr_flip_flop"]}
            },
            "required": ["state_element"]
          },
          "then": {
            "properties": {
              "trigger_model": {"const": "edge"}
            }
          }
        }
      ]
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title", "authors", "venue", "year", "accessed"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "title": {"type": "string", "minLength": 1},
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "venue": {"type": "string", "minLength": 1},
        "year": {"type": "integer", "minimum": 1900, "maximum": 2100},
        "doi": {
          "type": "string",
          "pattern": "^10\\.[0-9]{4,9}\\/.+$"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "accessed": {
          "type": "string",
          "format": "date"
        }
      },
      "anyOf": [
        {"required": ["doi"]},
        {"required": ["url"]}
      ]
    },
    "sourceLocator": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "page": {"type": "string", "minLength": 1},
        "figure": {"type": "string", "minLength": 1},
        "table": {"type": "string", "minLength": 1},
        "section": {"type": "string", "minLength": 1},
        "supplemental_artifact": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance_status",
        "citation",
        "locator",
        "redistribution"
      ],
      "properties": {
        "provenance_status": {
          "enum": [
            "primary_source_verified",
            "primary_source_unavailable",
            "secondary_only"
          ]
        },
        "citation": {"$ref": "#/$defs/citation"},
        "locator": {"$ref": "#/$defs/sourceLocator"},
        "artifact_url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "redistribution": {
          "enum": [
            "original_hdl_permitted",
            "reconstruction_only",
            "citation_only_no_redistribution",
            "unknown"
          ]
        }
      }
    },
    "reconstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "faithfulness_scope",
        "not_claimed",
        "transformations",
        "ambiguities",
        "assumptions"
      ],
      "properties": {
        "kind": {
          "enum": [
            "behavioral_equivalent",
            "topology_transcription",
            "coordinate_transcription"
          ]
        },
        "source_state_element": {
          "description": "State element in the cited source before any temporal adapter. Omit when it is identical to classification.state_element.",
          "enum": ["dff", "d_latch", "sr_flip_flop", "sr_latch"]
        },
        "temporal_relation": {
          "description": "same_model claims the same state-transition timing model. sampled_state_only preserves state only at explicit sampling boundaries, requires not_claimed to contain transparent_window_timing_equivalence, and does not claim equivalence during a latch's transparent window.",
          "enum": ["same_model", "sampled_state_only"]
        },
        "faithfulness_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "truth_table",
              "io_polarity",
              "clock_semantics",
              "gate_topology",
              "cell_coordinates",
              "reported_metrics"
            ]
          }
        },
        "not_claimed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "transformations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "ambiguities": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "assumptions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {
          "if": {"required": ["source_state_element"]},
          "then": {"required": ["temporal_relation"]}
        },
        {
          "if": {"required": ["temporal_relation"]},
          "then": {"required": ["source_state_element"]}
        }
      ]
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "clock_domains"],
      "properties": {
        "kind": {"enum": ["edge", "level"]},
        "clock_domains": {"const": 1},
        "edge": {"enum": ["posedge", "negedge"]},
        "level": {"enum": ["active_high", "active_low"]},
        "logical_clock_abstraction": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "edge"}}},
          "then": {"required": ["edge"]}
        },
        {
          "if": {"properties": {"kind": {"const": "level"}}},
          "then": {"required": ["level"]}
        }
      ]
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_element",
        "clock",
        "initial_state",
        "next_state_equation",
        "simultaneous_set_reset",
        "legal_input_contract",
        "physical_abstraction"
      ],
      "properties": {
        "state_element": {
          "enum": ["dff", "d_latch", "sr_flip_flop", "sr_latch"]
        },
        "clock": {"$ref": "#/$defs/clock"},
        "initial_state": {
          "enum": ["unknown", "reset_required", "specified"]
        },
        "initial_value": {"enum": [0, 1]},
        "next_state_equation": {"type": "string", "minLength": 1},
        "simultaneous_set_reset": {
          "enum": [
            "not_applicable",
            "forbidden",
            "hold",
            "set_priority",
            "reset_priority",
            "defined_value_0",
            "defined_value_1",
            "metastable_or_undefined"
          ]
        },
        "legal_input_contract": {"type": "string", "minLength": 1},
        "physical_abstraction": {
          "enum": [
            "abstract_state_boundary",
            "native_qca_state",
            "independent_physical_reconstruction"
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"initial_state": {"const": "specified"}}},
          "then": {"required": ["initial_value"]}
        },
        {
          "if": {
            "properties": {
              "state_element": {"enum": ["dff", "d_latch"]}
            }
          },
          "then": {
            "properties": {
              "simultaneous_set_reset": {"const": "not_applicable"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "state_element": {"enum": ["sr_flip_flop", "sr_latch"]}
            }
          },
          "then": {
            "properties": {
              "simultaneous_set_reset": {"not": {"const": "not_applicable"}}
            }
          }
        }
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256"],
      "properties": {
        "role": {
          "enum": [
            "rtl",
            "constraints",
            "testbench",
            "expected_trace",
            "truth_table",
            "yosys_script",
            "supplemental"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "reportedMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "unit",
        "source_locator",
        "normalization",
        "comparison_safe"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "value": {"type": ["number", "string"]},
        "unit": {"type": "string", "minLength": 1},
        "source_locator": {"type": "string", "minLength": 1},
        "normalization": {
          "enum": ["as_reported", "recomputed", "converted"]
        },
        "comparison_safe": {"type": "boolean"}
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "reason"],
      "properties": {
        "outcome": {
          "enum": ["pass", "reject", "prototype_expected", "not_run"]
        },
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "expectedPipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "yosys",
        "seqir",
        "legacy_cut",
        "sequential_pnr",
        "mapping",
        "physical_state_signoff"
      ],
      "properties": {
        "yosys": {"$ref": "#/$defs/stage"},
        "seqir": {"$ref": "#/$defs/stage"},
        "legacy_cut": {"$ref": "#/$defs/stage"},
        "sequential_pnr": {"$ref": "#/$defs/stage"},
        "mapping": {"$ref": "#/$defs/stage"},
        "physical_state_signoff": {
          "enum": ["not_characterized", "characterized", "not_applicable"]
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "evidence"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "fail", "not_run"]},
        "evidence": {"type": "string"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks"],
      "properties": {
        "status": {
          "enum": ["planned", "partially_validated", "validated"]
        },
        "checks": {
          "type": "array",
          "items": {"$ref": "#/$defs/check"}
        }
      }
    }
  }
}
